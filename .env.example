VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# hCaptcha sitekey (public). Get one at https://www.hcaptcha.com → Sites.
# Configure the matching secret in Supabase Dashboard → Auth → Settings → Bot/Abuse Protection.
# Leaving this blank disables the client-side widget — Supabase enforcement should also be off in that case.
VITE_HCAPTCHA_SITEKEY=
